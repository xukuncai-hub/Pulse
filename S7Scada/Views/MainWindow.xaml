<Window
    x:Class="S7Scada.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Pulse">
    <!--
        系统原生标题栏：最大化/最小化由 Windows 播放原生动画（同 VS Code / 普通窗口）。
        标题栏深色由 HandleTheme 通过 DWM 设置，随应用主题切换。
        WinUI 的 Window 没有 Background 属性，窗口底色由根 Grid 提供。
    -->
    <Grid x:Name="RootGrid" Background="#f8f9fb">
        <WebView2 x:Name="WebView" />
    </Grid>
</Window>
