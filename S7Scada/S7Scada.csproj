<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <!-- 无打包 + 自包含(已确认的部署模型):xcopy 即跑,无需 MSIX / Windows App Runtime -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64;x86;ARM64</Platforms>
    <AssemblyName>S7Scada</AssemblyName>
    <RootNamespace>S7Scada</RootNamespace>
    <!-- 应用图标（EXE 图标 + 运行时窗口/任务栏图标共用同一份多尺寸 ICO） -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
    <!-- 显式引用的 WebView2 SDK 覆盖 WinAppSDK 传递的老版本(1.0.3719.77)，
         以获得 CreateAsync(userDataFolder) 与 EventHandler 风格事件的现代 API 投影 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="S7netplus" Version="0.20.*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- AppWindow.SetIcon 需要在运行时能读到这个文件 -->
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- dotnet publish 不会自动复制 WinUI 的编译产物 .xbf/.pri，
       缺失时应用启动找不到 Application 资源会立即退出。这里在发布文件收集阶段补齐。 -->
  <Target Name="IncludeXbfInPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(BaseOutputPath)$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\App.xbf"
                             RelativePath="App.xbf"
                             CopyToPublishDirectory="PreserveNewest"
                             Condition="Exists('$(BaseOutputPath)$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\App.xbf')" />
      <ResolvedFileToPublish Include="$(BaseOutputPath)$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\Views\MainWindow.xbf"
                             RelativePath="Views\MainWindow.xbf"
                             CopyToPublishDirectory="PreserveNewest"
                             Condition="Exists('$(BaseOutputPath)$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\Views\MainWindow.xbf')" />
      <ResolvedFileToPublish Include="$(BaseOutputPath)$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\S7Scada.pri"
                             RelativePath="S7Scada.pri"
                             CopyToPublishDirectory="PreserveNewest"
                             Condition="Exists('$(BaseOutputPath)$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\S7Scada.pri')" />
    </ItemGroup>
  </Target>

</Project>
